{
  "name": "milo-service",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings service.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "../milo-app/node_modules/.bin/tsc -p tsconfig.json",
    "cli": "node --experimental-strip-types --no-warnings cli.ts",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "test:sidecar": "node scripts/test-sidecar.mjs"
  },
  "bin": {
    "milo": "./bin/milo"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
